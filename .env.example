# Google AdSense 클라이언트 ID (예: ca-pub-xxxxxxxxxxxxxxxx)
# 실제 발급받기 전에는 비워 두세요. 비어 있으면 광고 자리에 안내 플레이스홀더가 표시됩니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=

# 사이트 기본 URL (사이트맵·OG용). Vercel 배포 후 실제 도메인으로 바꾸세요.
# 커스텀 도메인(예: hyeonjang.kr)을 연결하면 GitHub/Vercel 기본 URL 대신 쓸 수 있습니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 세션 쿠키 서명용 비밀키 (32자 이상 랜덤 문자열). 저장소에 실제 값을 커밋하지 마세요.
SESSION_SECRET=change-me-to-a-long-random-string

# 최초 시드용 관리자 계정 (data/store.json 이 없을 때 생성). 실제 비밀번호는 .env.local 에만 두세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Supabase 영속 저장소 (선택) ─────────────────────────────
# 둘 다 설정하면 회원·추천코드가 Supabase hj_store 테이블(단일 행 JSON)에 저장됩니다.
# 비워 두면 기존 로컬 파일 저장소(data/store.json)로 폴백합니다.
# SUPABASE_URL: Supabase 프로젝트 설정 > API > Project URL (예: https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: 프로젝트 설정 > API > service_role 키 (서버 전용! 절대 브라우저에 노출 금지,
#   NEXT_PUBLIC_ 접두사를 붙이지 마세요. 클라이언트에 노출되면 누구나 DB를 조작할 수 있습니다.)
# 테이블 생성: supabase/schema.sql 을 Supabase SQL Editor에서 실행하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
