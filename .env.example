# Google AdSense 클라이언트 ID (예: ca-pub-xxxxxxxxxxxxxxxx)
# 실제 발급받기 전에는 비워 두세요.
#
# 슬롯은 5개입니다. 단위 ID가 없으면 그 자리만 조용히 사라집니다.
#   BANNER       : 홈·카테고리 상단
#   SIDEBAR      : 사이드바 (세로)
#   IN_ARTICLE   : 본문 중간 (35~60% 지점에 자동 삽입)
#   IN_ARTICLE_2 : 본문 하단
#   FOOTER       : 전 페이지 푸터
# 방금 발급받은 단위는 빌드 시점에 고정되므로, 추가하면 다시 빌드·배포해야 반영됩니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE_2=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# 사이트 기본 URL (사이트맵·OG용). Vercel 배포 후 실제 도메인으로 바꾸세요.
# 커스텀 도메인(예: hyeonjang.kr)을 연결하면 GitHub/Vercel 기본 URL 대신 쓸 수 있습니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 세션 쿠키 서명용 비밀키 (32자 이상 랜덤 문자열). 저장소에 실제 값을 커밋하지 마세요.
SESSION_SECRET=change-me-to-a-long-random-string

# 최초 시드용 관리자 계정 (data/store.json 이 없을 때 생성). 실제 비밀번호는 .env.local 에만 두세요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Supabase 영속 저장소 (선택) ─────────────────────────────
# 둘 다 설정하면 회원·추천코드와 뉴스레터 구독자가 Supabase에 저장됩니다.
#   hj_store (회원·추천코드) / hj_subscribers (구독자)
# 비워 두면 로컬 파일 저장소(data/store.json, data/subscribers.json)로 폴백합니다.
# 폴백은 로컬 개발용입니다. Vercel 서버리스의 읽기 전용 파일 시스템에서는 보존되지 않습니다.
# SUPABASE_URL: Supabase 프로젝트 설정 > API > Project URL (예: https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: 프로젝트 설정 > API > service_role 키 (서버 전용! 절대 브라우저에 노출 금지,
#   NEXT_PUBLIC_ 접두사를 붙이지 마세요. 클라이언트에 노출되면 누구나 DB를 조작할 수 있습니다.)
# 테이블 생성: supabase/schema.sql 을 Supabase SQL Editor에서 실행하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
